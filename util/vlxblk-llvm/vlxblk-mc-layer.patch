                 opcodestr, "$vs3, (${rs1}), $vs2$vm">;
 
+// indexed block load vd, (rs1), vs2 (custom VLXBLK, unmasked)
+class VIndexedBlockLoad<bits<7> funct7, RISCVWidth width, string opcodestr>
+    : RVInstVLXBLK<funct7, width.Value{2-0},
+                   (outs VR:$vd),
+                   (ins GPR:$rs1, VR:$vs2),
+                   opcodestr, "$vd, (${rs1}), $vs2">;
+
+// indexed block store vs3, (rs1), vs2 (custom VSXBLK, unmasked; the store-
+// data register occupies the vd field of the encoding)
+class VIndexedBlockStore<bits<7> funct7, RISCVWidth width, string opcodestr>
+    : RVInstVLXBLK<funct7, width.Value{2-0},
+                   (outs),
+                   (ins VR:$vd, GPR:$rs1, VR:$vs2),
+                   opcodestr, "$vd, (${rs1}), $vs2">;
+
 // segment store vd, vs3, (rs1), vm
