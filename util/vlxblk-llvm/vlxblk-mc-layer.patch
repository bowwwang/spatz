--- a/llvm/lib/Target/RISCV/RISCVInstrFormatsV.td
+++ b/llvm/lib/Target/RISCV/RISCVInstrFormatsV.td
@@ -267,6 +267,39 @@ class RVInstVLX<bits<3> nf, bit mew, RISCVMOP mop, bits<3> width,
   let RVVConstraint = VMConstraint;
 }
 
+// Custom VLXBLK/VSXBLK indexed block load/store on custom-1 (0101011):
+// one index per block of blk_len contiguous SEW elements; blk_len is
+// architectural state set by vsetblklen. No vm field: always unmasked.
+class RVInstVLXBLK<bits<7> funct7, bits<3> width,
+                   dag outs, dag ins, string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> vs2;
+  bits<5> rs1;
+  bits<5> vd;
+
+  let Inst{31-25} = funct7;
+  let Inst{24-20} = vs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = width;
+  let Inst{11-7}  = vd;
+  let Inst{6-0}   = 0b0101011;
+
+  let Uses = [VTYPE, VL];
+}
+
+// vsetblklen rs1: write the VLXBLK block length from a scalar register.
+class RVInstVSetBlkLen<dag outs, dag ins, string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs1;
+
+  let Inst{31-25} = 0b0001111;
+  let Inst{24-20} = 0b00000;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = 0b000;
+  let Inst{11-7}  = 0b00000;
+  let Inst{6-0}   = 0b0101011;
+}
+
 class RVInstVSU<bits<3> nf, bit mew, RISCVLSUMOP sumop,
                 bits<3> width, dag outs, dag ins, string opcodestr,
                 string argstr>
